NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

# Ports are off the defaults so this stack can run alongside HookRelay.
DATABASE_URL=postgres://modelgate:modelgate@localhost:5433/modelgate
REDIS_URL=redis://localhost:6380

DB_POOL_MAX=20

# Guards every gateway route. No default is offered: a shipped default key
# looks like protection while being public knowledge. Minimum 16 characters.
GATEWAY_API_KEY=replace-with-a-long-random-value

# The failover chain, tried left to right. Two mock entries mean two separate
# servers. Two keys for one provider would not be two providers: rate limits
# are per organisation, so both would run out together.
PROVIDER_ORDER=mock-primary,mock-backup

# Start these with: npm run mock  (and MOCK_PORT=3201 npm run mock)
MOCK_PRIMARY_URL=http://127.0.0.1:3200
MOCK_BACKUP_URL=http://127.0.0.1:3201

# Tries at each provider before moving to the next one.
MAX_ATTEMPTS_PER_PROVIDER=2
RETRY_BASE_MS=100
RETRY_CAP_MS=2000

# Real provider. Free tier, no card: https://console.groq.com -> API Keys.
# Add groq to PROVIDER_ORDER to use it; the gateway refuses to boot with groq
# in the chain and no key, rather than failing over past it forever.
GROQ_BASE_URL=https://api.groq.com
# GROQ_API_KEY=
